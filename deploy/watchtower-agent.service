[Unit]
Description=Watchtower agent
After=network-online.target
Wants=network-online.target

[Service]
User=watchtower
Group=watchtower
# NOTE: docker group is included for docker hosts; on docker-less hosts,
# remove it here or the unit fails to start (missing group = exit 216).
SupplementaryGroups=systemd-journal adm docker
ExecStart=/usr/local/bin/watchtower-agent run
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/watchtower/spool
RuntimeDirectory=watchtower
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
